DASHBOARD_TRACKING_URL=
# Same ingest token used by the dashboard, configured locally as a secret.
DASHBOARD_INGEST_TOKEN=
ALLOWED_ORIGINS=https://aigrowth.my.id
DASHBOARD_PAYLOAD_MODE=records
